# Neon pooled connection string. Set automatically by the Vercel Marketplace integration.
DATABASE_URL=
# Neon direct (unpooled) connection string. Used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional. Comma-separated emails that become admins when they sign in.
ADMIN_EMAILS=
# Public base URL of the site. Used for links inside text messages. Falls back to AUTH_URL.
APP_URL=
# Email alerts through Amazon SES. Leave SES_FROM_ADDRESS blank to turn email alerts off.
# The sender must be on a domain or address verified in SES. Example: Closing the Gap <alerts@example.com>
SES_FROM_ADDRESS=
# Defaults to us-west-2.
SES_AWS_REGION=
# Optional. Locally the AWS SDK uses your CLI credentials. On Vercel set these two,
# because Vercel reserves AWS_* names. Use an IAM user that can only call ses:SendEmail.
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=
# SES allows this many emails a second. New accounts get 1.
SES_MAX_SEND_RATE=
# Set to true to log emails to the server console instead of sending them. For local demos.
EMAIL_DRY_RUN=
