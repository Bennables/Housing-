# Neon pooled connection string. Set automatically by the Vercel Marketplace integration.
DATABASE_URL=
# Neon direct (unpooled) connection string. Used by drizzle-kit for migrations.
DATABASE_URL_UNPOOLED=
# Generate with: openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Optional. Comma-separated emails that become admins when they sign in.
ADMIN_EMAILS=
# Optional: text alerts. Without these, no matching runs and no texts are sent.
ANTHROPIC_API_KEY=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional. Public site address used in text links. Falls back to the Vercel URL.
APP_URL=
